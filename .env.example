# TataDana Environment Variables Template
# Salin berkas ini ke .env.local untuk konfigurasi lokal, atau masukkan ke Vercel Settings -> Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=exports

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
WEBHOOK_BASE_URL=https://your-app.vercel.app

# Admin Credentials
ADMIN_EMAIL=youknowzhia@gmail.com
ADMIN_USERNAME=admindana

# Optional AI Providers (bisa dikonfigurasi lewat Admin Hub atau ENV)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
